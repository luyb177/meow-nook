syntax = "v1"

info(
    title: "meow-nook API gateway"
    desc: "予喵安隅 HTTP API gateway"
    author: "meow-nook team"
    version: "1.0"
)

// ──────────────────────────────────────────────
// Auth (no JWT required)
// ──────────────────────────────────────────────

type (
    RegisterReq {
        Username string `json:"username"`
        Password string `json:"password"`
        Phone    string `json:"phone"`
    }
    RegisterResp {
        UserId int64  `json:"userId"`
        Token  string `json:"token"`
    }
    LoginReq {
        Username string `json:"username"`
        Password string `json:"password"`
    }
    LoginResp {
        UserId int64  `json:"userId"`
        Token  string `json:"token"`
    }
)

@server(
    prefix: /api/v1/auth
)
service gateway {
    @handler Register
    post /register (RegisterReq) returns (RegisterResp)

    @handler Login
    post /login (LoginReq) returns (LoginResp)
}

// ──────────────────────────────────────────────
// User
// ──────────────────────────────────────────────

type (
    UserInfoResp {
        Id        int64  `json:"id"`
        Username  string `json:"username"`
        Avatar    string `json:"avatar"`
        Phone     string `json:"phone"`
        Area      string `json:"area"`
        Gender    string `json:"gender"`
        Points    int32  `json:"points"`
        Role      string `json:"role"`
        CreatedAt int64  `json:"createdAt"`
    }
    UpdateUserInfoReq {
        Username     string   `json:"username,optional"`
        Avatar       string   `json:"avatar,optional"`
        Phone        string   `json:"phone,optional"`
        Area         string   `json:"area,optional"`
        Gender       string   `json:"gender,optional"`
        ServiceTypes []string `json:"serviceTypes,optional"`
    }
    ChangePasswordReq {
        OldPassword string `json:"oldPassword"`
        NewPassword string `json:"newPassword"`
    }
    PointsResp {
        Points int32 `json:"points"`
    }
    PointLog {
        Id        int64  `json:"id"`
        Delta     int32  `json:"delta"`
        Reason    string `json:"reason"`
        TaskId    string `json:"taskId"`
        Balance   int32  `json:"balance"`
        CreatedAt int64  `json:"createdAt"`
    }
    PointLogsResp {
        Logs  []PointLog `json:"logs"`
        Total int64      `json:"total"`
    }
    NotificationSettings {
        TaskNotify     bool `json:"taskNotify"`
        AdoptionNotify bool `json:"adoptionNotify"`
        PointsNotify   bool `json:"pointsNotify"`
        SystemNotify   bool `json:"systemNotify"`
        MessageNotify  bool `json:"messageNotify"`
    }
    FeedbackReq {
        FeedbackType string `json:"feedbackType"`
        Content      string `json:"content"`
        Contact      string `json:"contact"`
    }
    FeedbackResp {
        FeedbackId int64 `json:"feedbackId"`
    }
)

@server(
    prefix: /api/v1/user
    middleware: Auth
)
service gateway {
    @handler GetUserInfo
    get /info returns (UserInfoResp)

    @handler UpdateUserInfo
    put /info (UpdateUserInfoReq)

    @handler ChangePassword
    put /password (ChangePasswordReq)

    @handler GetPoints
    get /points returns (PointsResp)

    @handler ListPointLogs
    get /points/logs returns (PointLogsResp)

    @handler GetNotificationSettings
    get /notifications returns (NotificationSettings)

    @handler UpdateNotificationSettings
    put /notifications (NotificationSettings)

    @handler SubmitFeedback
    post /feedback (FeedbackReq) returns (FeedbackResp)

    @handler Logout
    post /logout
}

// ──────────────────────────────────────────────
// Cats
// ──────────────────────────────────────────────

type (
    CatInfo {
        Id             int64    `json:"id"`
        Name           string   `json:"name"`
        Gender         int32    `json:"gender"`
        AgeStage       int32    `json:"ageStage"`
        Size           int32    `json:"size"`
        NeuterStatus   int32    `json:"neuterStatus"`
        AdoptionStatus int32    `json:"adoptionStatus"`
        FoundLocation  string   `json:"foundLocation"`
        FoundLat       float64  `json:"foundLat"`
        FoundLng       float64  `json:"foundLng"`
        Description    string   `json:"description"`
        Tags           []string `json:"tags"`
        Photos         []string `json:"photos"`
        CreatedAt      int64    `json:"createdAt"`
        UpdatedAt      int64    `json:"updatedAt"`
    }
    ListCatsReq {
        Gender         int32  `form:"gender,optional"`
        Size           int32  `form:"size,optional"`
        AgeStage       int32  `form:"ageStage,optional"`
        NeuterStatus   int32  `form:"neuterStatus,optional"`
        AdoptionStatus int32  `form:"adoptionStatus,optional"`
        Keyword        string `form:"keyword,optional"`
        Page           int32  `form:"page,optional,default=1"`
        PageSize       int32  `form:"pageSize,optional,default=20"`
    }
    ListCatsResp {
        Cats  []CatInfo `json:"cats"`
        Total int64     `json:"total"`
    }
    CreateCatReq {
        Name           string   `json:"name"`
        Gender         int32    `json:"gender"`
        AgeStage       int32    `json:"ageStage"`
        Size           int32    `json:"size"`
        NeuterStatus   int32    `json:"neuterStatus"`
        AdoptionStatus int32    `json:"adoptionStatus"`
        FoundLocation  string   `json:"foundLocation"`
        FoundLat       float64  `json:"foundLat"`
        FoundLng       float64  `json:"foundLng"`
        Description    string   `json:"description,optional"`
        Tags           []string `json:"tags,optional"`
        Photos         []string `json:"photos,optional"`
    }
    CreateCatResp {
        CatId int64 `json:"catId"`
    }
    UpdateCatReq {
        Name           string   `json:"name,optional"`
        Gender         int32    `json:"gender,optional"`
        AgeStage       int32    `json:"ageStage,optional"`
        Size           int32    `json:"size,optional"`
        NeuterStatus   int32    `json:"neuterStatus,optional"`
        AdoptionStatus int32    `json:"adoptionStatus,optional"`
        FoundLocation  string   `json:"foundLocation,optional"`
        FoundLat       float64  `json:"foundLat,optional"`
        FoundLng       float64  `json:"foundLng,optional"`
        Description    string   `json:"description,optional"`
        Tags           []string `json:"tags,optional"`
        Photos         []string `json:"photos,optional"`
    }
    RescueRecord {
        Id          int64  `json:"id"`
        CatId       int64  `json:"catId"`
        RescuerId   int64  `json:"rescuerId"`
        RescuerName string `json:"rescuerName"`
        Status      string `json:"status"`
        Description string `json:"description"`
        RescueTime  int64  `json:"rescueTime"`
    }
    AddRescueRecordReq {
        Status      string `json:"status"`
        Description string `json:"description"`
    }
    HealthRecord {
        Id         int64  `json:"id"`
        CatId      int64  `json:"catId"`
        RecordType string `json:"recordType"`
        Content    string `json:"content"`
        Operator   string `json:"operator"`
        RecordDate int64  `json:"recordDate"`
    }
    AddHealthRecordReq {
        RecordType string `json:"recordType"`
        Content    string `json:"content"`
        Operator   string `json:"operator"`
        RecordDate int64  `json:"recordDate"`
    }
    CatStatsResp {
        TotalCats        int64 `json:"totalCats"`
        NeuteredCats     int64 `json:"neuteredCats"`
        AdoptedCats      int64 `json:"adoptedCats"`
        ActiveVolunteers int64 `json:"activeVolunteers"`
    }
    HeatmapReq {
        MapType   string `form:"mapType,optional"`
        CatStatus string `form:"catStatus,optional"`
        TimeFrom  int64  `form:"timeFrom,optional"`
        TimeTo    int64  `form:"timeTo,optional"`
        Area      string `form:"area,optional"`
    }
    HeatmapPoint {
        Lat    float64 `json:"lat"`
        Lng    float64 `json:"lng"`
        Weight int32   `json:"weight"`
        Area   string  `json:"area"`
    }
    HeatmapResp {
        Points []HeatmapPoint `json:"points"`
    }
    PathIdReq {
        Id int64 `path:"id"`
    }
)

@server(
    prefix: /api/v1/cats
    middleware: Auth
)
service gateway {
    @handler ListCats
    get / (ListCatsReq) returns (ListCatsResp)

    @handler CreateCat
    post / (CreateCatReq) returns (CreateCatResp)

    @handler GetCatStats
    get /stats returns (CatStatsResp)

    @handler GetHeatmap
    get /heatmap (HeatmapReq) returns (HeatmapResp)

    @handler GetCat
    get /:id (PathIdReq) returns (CatInfo)

    @handler UpdateCat
    put /:id (UpdateCatReq)

    @handler DeleteCat
    delete /:id (PathIdReq)

    @handler ListRescueRecords
    get /:id/rescue (PathIdReq) returns ([]RescueRecord)

    @handler AddRescueRecord
    post /:id/rescue (AddRescueRecordReq) returns (RescueRecord)

    @handler ListHealthRecords
    get /:id/health (PathIdReq) returns ([]HealthRecord)

    @handler AddHealthRecord
    post /:id/health (AddHealthRecordReq) returns (HealthRecord)
}

// ──────────────────────────────────────────────
// Tasks
// ──────────────────────────────────────────────

type (
    TaskInfo {
        Id               int64   `json:"id"`
        CatId            int64   `json:"catId"`
        CatName          string  `json:"catName"`
        Title            string  `json:"title"`
        Description      string  `json:"description"`
        TaskType         int32   `json:"taskType"`
        Urgency          int32   `json:"urgency"`
        Difficulty       int32   `json:"difficulty"`
        Status           int32   `json:"status"`
        PointsReward     int32   `json:"pointsReward"`
        MaxAssignees     int32   `json:"maxAssignees"`
        CurrentAssignees int32   `json:"currentAssignees"`
        Deadline         int64   `json:"deadline"`
        CreatedBy        int64   `json:"createdBy"`
        CreatedAt        int64   `json:"createdAt"`
        UpdatedAt        int64   `json:"updatedAt"`
        Location         string  `json:"location"`
        Lat              float64 `json:"lat"`
        Lng              float64 `json:"lng"`
    }
    TaskLog {
        Id         int64  `json:"id"`
        TaskId     int64  `json:"taskId"`
        OperatorId int64  `json:"operatorId"`
        Operator   string `json:"operator"`
        Action     string `json:"action"`
        Remark     string `json:"remark"`
        CreatedAt  int64  `json:"createdAt"`
    }
    TaskAssignee {
        UserId     int64  `json:"userId"`
        Username   string `json:"username"`
        Status     string `json:"status"`
        AssignedAt int64  `json:"assignedAt"`
    }
    GetTaskResp {
        Task      TaskInfo       `json:"task"`
        Logs      []TaskLog      `json:"logs"`
        Assignees []TaskAssignee `json:"assignees"`
    }
    ListTasksReq {
        CatId      int64   `form:"catId,optional"`
        TaskType   int32   `form:"taskType,optional"`
        Urgency    int32   `form:"urgency,optional"`
        Status     int32   `form:"status,optional"`
        AssignedTo int64   `form:"assignedTo,optional"`
        NearLat    float64 `form:"nearLat,optional"`
        NearLng    float64 `form:"nearLng,optional"`
        RadiusKm   float64 `form:"radiusKm,optional"`
        Page       int32   `form:"page,optional,default=1"`
        PageSize   int32   `form:"pageSize,optional,default=20"`
    }
    ListTasksResp {
        Tasks []TaskInfo `json:"tasks"`
        Total int64      `json:"total"`
    }
    CreateTaskReq {
        CatId        int64   `json:"catId"`
        Title        string  `json:"title"`
        Description  string  `json:"description"`
        TaskType     int32   `json:"taskType"`
        Urgency      int32   `json:"urgency"`
        Difficulty   int32   `json:"difficulty"`
        PointsReward int32   `json:"pointsReward"`
        MaxAssignees int32   `json:"maxAssignees,optional,default=1"`
        Deadline     int64   `json:"deadline"`
        Location     string  `json:"location,optional"`
        Lat          float64 `json:"lat,optional"`
        Lng          float64 `json:"lng,optional"`
    }
    CreateTaskResp {
        TaskId int64 `json:"taskId"`
    }
    UpdateTaskReq {
        Title       string `json:"title,optional"`
        Description string `json:"description,optional"`
        Urgency     int32  `json:"urgency,optional"`
        Difficulty  int32  `json:"difficulty,optional"`
        Status      int32  `json:"status,optional"`
        Deadline    int64  `json:"deadline,optional"`
        Remark      string `json:"remark,optional"`
    }
    AbandonTaskReq {
        Reason string `json:"reason,optional"`
    }
    CompleteTaskReq {
        Proof string `json:"proof,optional"`
    }
    ExtendDeadlineReq {
        NewDeadline int64 `json:"newDeadline"`
    }
)

@server(
    prefix: /api/v1/tasks
    middleware: Auth
)
service gateway {
    @handler ListTasks
    get / (ListTasksReq) returns (ListTasksResp)

    @handler CreateTask
    post / (CreateTaskReq) returns (CreateTaskResp)

    @handler GetTask
    get /:id (PathIdReq) returns (GetTaskResp)

    @handler UpdateTask
    put /:id (UpdateTaskReq)

    @handler ClaimTask
    post /:id/claim (PathIdReq)

    @handler AbandonTask
    post /:id/abandon (AbandonTaskReq)

    @handler CompleteTask
    post /:id/complete (CompleteTaskReq)

    @handler ExtendDeadline
    post /:id/extend (ExtendDeadlineReq)
}

// ──────────────────────────────────────────────
// Adoption
// ──────────────────────────────────────────────

type (
    AdoptionApplication {
        Id             int64  `json:"id"`
        CatId          int64  `json:"catId"`
        CatName        string `json:"catName"`
        ApplicantId    int64  `json:"applicantId"`
        ApplicantName  string `json:"applicantName"`
        Status         int32  `json:"status"`
        RejectReason   string `json:"rejectReason"`
        RequiredPoints int32  `json:"requiredPoints"`
        AppliedAt      int64  `json:"appliedAt"`
        UpdatedAt      int64  `json:"updatedAt"`
    }
    ApplyAdoptionReq {
        CatId int64  `json:"catId"`
        Note  string `json:"note,optional"`
    }
    ApplyAdoptionResp {
        ApplicationId int64 `json:"applicationId"`
    }
    ListAdoptionReq {
        Status   int32 `form:"status,optional"`
        Page     int32 `form:"page,optional,default=1"`
        PageSize int32 `form:"pageSize,optional,default=20"`
    }
    ListAdoptionResp {
        Applications []AdoptionApplication `json:"applications"`
        Total        int64                 `json:"total"`
    }
    ReviewApplicationReq {
        Approved     bool   `json:"approved"`
        RejectReason string `json:"rejectReason,optional"`
    }
    FollowUpRecord {
        Id            int64    `json:"id"`
        ApplicationId int64    `json:"applicationId"`
        ApplicantId   int64    `json:"applicantId"`
        Stage         string   `json:"stage"`
        Content       string   `json:"content"`
        Photos        []string `json:"photos"`
        SubmittedAt   int64    `json:"submittedAt"`
    }
    SubmitFollowUpReq {
        Stage   string   `json:"stage"`
        Content string   `json:"content"`
        Photos  []string `json:"photos,optional"`
    }
    AdoptionPathIdReq {
        Id int64 `path:"id"`
    }
)

@server(
    prefix: /api/v1/adoption
    middleware: Auth
)
service gateway {
    @handler ListAdoptions
    get / (ListAdoptionReq) returns (ListAdoptionResp)

    @handler ApplyAdoption
    post /apply (ApplyAdoptionReq) returns (ApplyAdoptionResp)

    @handler GetAdoption
    get /:id (AdoptionPathIdReq) returns (AdoptionApplication)

    @handler ReviewAdoption
    post /:id/review (ReviewApplicationReq)

    @handler ListFollowUps
    get /:id/followup (AdoptionPathIdReq) returns ([]FollowUpRecord)

    @handler SubmitFollowUp
    post /:id/followup (SubmitFollowUpReq)
}

// ──────────────────────────────────────────────
// Posts / dynamics
// ──────────────────────────────────────────────

type (
    PostInfo {
        Id         int64    `json:"id"`
        AuthorId   int64    `json:"authorId"`
        AuthorName string   `json:"authorName"`
        Avatar     string   `json:"avatar"`
        CatId      int64    `json:"catId"`
        CatName    string   `json:"catName"`
        Content    string   `json:"content"`
        Images     []string `json:"images"`
        Likes      int32    `json:"likes"`
        Comments   int32    `json:"comments"`
        Favorites  int32    `json:"favorites"`
        CreatedAt  int64    `json:"createdAt"`
    }
    ListPostsReq {
        CatId    int64 `form:"catId,optional"`
        AuthorId int64 `form:"authorId,optional"`
        Page     int32 `form:"page,optional,default=1"`
        PageSize int32 `form:"pageSize,optional,default=20"`
    }
    ListPostsResp {
        Posts []PostInfo `json:"posts"`
        Total int64      `json:"total"`
    }
    CreatePostReq {
        CatId   int64    `json:"catId"`
        Content string   `json:"content"`
        Images  []string `json:"images,optional"`
    }
    CreatePostResp {
        PostId int64 `json:"postId"`
    }
    CommentInfo {
        Id         int64  `json:"id"`
        PostId     int64  `json:"postId"`
        AuthorId   int64  `json:"authorId"`
        AuthorName string `json:"authorName"`
        Avatar     string `json:"avatar"`
        Content    string `json:"content"`
        CreatedAt  int64  `json:"createdAt"`
    }
    ListCommentsResp {
        Comments []CommentInfo `json:"comments"`
        Total    int64         `json:"total"`
    }
    AddCommentReq {
        Content string `json:"content"`
    }
    ReportPostReq {
        Reason string `json:"reason"`
    }
    PostPathIdReq {
        Id int64 `path:"id"`
    }
    CommentPathReq {
        Id  int64 `path:"id"`
        Cid int64 `path:"cid"`
    }
    ListCommentsReq {
        Page     int32 `form:"page,optional,default=1"`
        PageSize int32 `form:"pageSize,optional,default=20"`
    }
)

@server(
    prefix: /api/v1/posts
    middleware: Auth
)
service gateway {
    @handler ListPosts
    get / (ListPostsReq) returns (ListPostsResp)

    @handler CreatePost
    post / (CreatePostReq) returns (CreatePostResp)

    @handler GetPost
    get /:id (PostPathIdReq) returns (PostInfo)

    @handler DeletePost
    delete /:id (PostPathIdReq)

    @handler LikePost
    post /:id/like (PostPathIdReq)

    @handler UnlikePost
    post /:id/unlike (PostPathIdReq)

    @handler FavoritePost
    post /:id/favorite (PostPathIdReq)

    @handler UnfavoritePost
    post /:id/unfavorite (PostPathIdReq)

    @handler ListComments
    get /:id/comments (ListCommentsReq) returns (ListCommentsResp)

    @handler AddComment
    post /:id/comments (AddCommentReq)

    @handler DeleteComment
    delete /:id/comments/:cid (CommentPathReq)

    @handler ReportPost
    post /:id/report (ReportPostReq)
}
